# Copiar a .env y completar. NUNCA subir .env al repositorio.

# --- Aplicación ---
ENV=development            # development | production (en production se deshabilita Swagger)
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Base de datos (MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=voleyia
DB_USER=voleyia
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Seguridad ---
JWT_SECRET_KEY=            # cadena aleatoria larga (p. ej. openssl rand -hex 32)
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# --- OpenRouter (IA) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_PRINCIPAL=
OPENROUTER_MODEL_RESPALDO=
OPENROUTER_TIMEOUT_S=15
OPENROUTER_MAX_TOKENS_RUTINA=4000
OPENROUTER_MAX_TOKENS_RIESGO=2000

# --- Respaldos ---
BACKUP_DIR=./backups
BACKUP_GPG_PASSPHRASE=
